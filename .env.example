# ==========================================
# EMAIL CONFIGURATION
# ==========================================
SENDER_EMAIL=
EMAIL_SUBJECT=
EMAIL_TEMPLATE_FILE=templates/template.html
RESUME_FILE=attachments/resume.pdf
RECRUITER_CSV_FILE=data/recruiter_contacts.csv

# ==========================================
# WORKERS & PERFORMANCE
# ==========================================
NUM_WORKERS=3
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
GMAIL_API_REQUEST_DELAY=0

# ==========================================
# EXCEL DIRECTORY
# ==========================================
EXCEL_DIRECTORY_ENABLED=true
EXCEL_DIRECTORY_FILE=data/recruiter_email_backup.xlsx

# ==========================================
# BOUNCE DETECTION
# ==========================================
BOUNCE_CHECK_ENABLED=true
BOUNCE_CHECK_DELAY_SECONDS=5

# ==========================================
# LOGGING
# ==========================================
LOGGING_ENABLED=true
LOG_FILE=logs/outreach.log

# ==========================================
# DASHBOARD
# ==========================================
DASHBOARD_ENABLED=true
DASHBOARD_REFRESH_RATE=4

# ==========================================
# GMAIL API / OAUTH
# ==========================================
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ==========================================
# EXECUTION
# ==========================================
DRY_RUN=false
